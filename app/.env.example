# Copy to .env and fill in. The backend reads these via python-dotenv.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides:
# COMPETITOR_MODEL=claude-opus-4-8     # default; set claude-sonnet-4-6 to cut cost ~40%
# COMPETITOR_EFFORT=high               # low | medium | high | xhigh | max
# COMPETITOR_SKEPTICS=2                # verifiers per claim (Phase E)
